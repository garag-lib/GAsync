{
    "name": "garag-lib/gasync",
    "description": "Cooperative asynchronous streams, timers, sockets and worker processes for PHP 8.3+",
    "type": "library",
    "license": "LGPL-2.1-only",
    "autoload": {
        "psr-4": {
            "GaragLib\\": "src/GaragLib/",
            "GaragLib\\MysqliPDO\\": "src/GaragLib/GMysqliPDO/"
        }
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "suggest": {
        "ext-ev": "Optional libev driver",
        "ext-event": "Optional libevent driver",
        "ext-pcntl": "Unix worker processes",
        "ext-posix": "Unix worker processes",
        "ext-pdo": "Native PDO facade",
        "ext-pdo_mysql": "PDO MySQL connection",
        "ext-mysqli": "Independent asynchronous MySQL connection (mysqlnd required)",
        "ext-sysvsem": "Cross-process database connection limit",
        "ext-sockets": "Detailed asynchronous socket connection errors"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src tests examples test -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    }
}
